{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASM guide frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "summary",
    "status",
    "updated"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "guide"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "retired"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  }
}
