    def test_mermaid_source_and_self_hosted_runtime_are_preserved(self):
        diagram='---\nconfig:\n  layout: elk\n---\nflowchart TD\n  A[Observe] --> B[Investigate]\n'
        guide=self.root/'docs/diagram-example.md'
        guide.write_text('# Diagram example\n\n```mermaid\n'+diagram+'```\n')
        build(self.root)
        out=self.root/'dist'
        page=ET.HTML((out/'docs/diagram-example.html').read_text())
        self.assertEqual(page.xpath('//pre/code[@class="language-mermaid"]/text()'),[diagram])
        self.assertTrue(page.xpath('//script[@type="module"][starts-with(@src,"../assets/adm-mermaid.js")]'))
        self.assertEqual((out/'docs/diagram-example.md').read_text(),guide.read_text())
        vendor=out/'assets/vendor/mermaid-12.2.0'
        self.assertEqual((vendor/'mermaid.esm.min.mjs').read_bytes(),(ROOT/'node_modules/mermaid/dist/mermaid.esm.min.mjs').read_bytes())
        self.assertTrue((vendor/'LICENSE').is_file())
        self.assertFalse(list(vendor.rglob('*.map')))
        # Every static or lazy relative module import must survive packaging.
        for module in vendor.rglob('*.mjs'):
            for path in re.findall(r'["\'](\.{1,2}/[^"\']+\.mjs)["\']',module.read_text()):
                self.assertTrue((module.parent/path).is_file(),str(module)+': '+path)

    def test_review_tools_are_local_and_use_stable_page_keys(self):
        docs,_,_=build(self.root)
        out=self.root/'dist'
        for doc in docs:
            page=ET.HTML((out/doc['path']).read_text())
            script=page.xpath('//script[@data-project="agent-diagnostic-manual"]')[0]
            self.assertEqual(script.get('data-page'),doc['meta']['id'])
            self.assertIn('annotate-1.5.3.js',script.get('src'))
            self.assertFalse(script.get('src').startswith('https:'))
            self.assertIsNone(script.get('data-api'))
            self.assertIsNone(script.get('data-post-url'))
            controls=page.xpath('//template[@id="adm-review-controls"]')[0]
            self.assertTrue(controls.xpath('.//button[@id="adm-review-export"][@aria-label="Export all comments"]'))
            self.assertTrue(controls.xpath('.//button[@id="adm-review-clear"][@aria-label="Clear all comments"]'))
            self.assertTrue(controls.xpath('.//button[@id="adm-review-undo"][@hidden]'))
            self.assertFalse(page.xpath('//main//button[starts-with(@id,"adm-review-")]'))
        home=ET.HTML((out/'index.html').read_text())
        self.assertEqual(home.xpath('//script[@data-project]/@data-page'),['index.md'])
        guide=ET.HTML((out/'docs/authoring-diagnosis.html').read_text())
        self.assertEqual(guide.xpath('//script[@data-project]/@data-page'),['docs/authoring-diagnosis.md'])
        self.assertEqual((out/'assets/vendor/annotate-1.5.3.js').read_bytes(),(ROOT/'node_modules/@reviewjs/annotate/annotate.js').read_bytes())
        self.assertTrue((out/'assets/vendor/annotate-LICENSE.txt').is_file())

