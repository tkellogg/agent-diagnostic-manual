  </xs:group>
  <xs:complexType name="blocks">
    <xs:group ref="a:blocks" minOccurs="1" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:complexType name="section">
    <xs:group ref="a:blocks" minOccurs="1" maxOccurs="unbounded"/>
